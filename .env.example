# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_PAGESPEED_API_KEY: Optional. If provided, used for Google PageSpeed Insights API queries.
# If omitted or rate-limited, SiteScope automatically runs its built-in Live DOM & Network Inspector.
GOOGLE_PAGESPEED_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional for ₹10 UPI micro-payments.
# If omitted, SiteScope runs in interactive test simulator mode for testing.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# DODO_PAYMENTS Configuration: For live UPI and Card checkouts
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_PRODUCT_ID=""
DODO_PAYMENTS_ENV="test" # "test" or "live"
DODO_WEBHOOK_SECRET=""

# RESEND Configuration: For Passwordless 6-Digit Email OTP Authentication
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SiteScope <onboarding@resend.dev>"


