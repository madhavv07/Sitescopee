rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.email is string &&
             data.email.size() <= 200 &&
             data.uid == request.auth.uid;
    }

    function isValidAnalysis(data) {
      return data.id is string &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.url is string &&
             data.url.size() <= 500 &&
             data.domain is string &&
             data.domain.size() <= 200 &&
             (data.strategy == 'mobile' || data.strategy == 'desktop');
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      match /analyses/{analysisId} {
        allow get: if isValidId(userId) && isValidId(analysisId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(analysisId) && isOwner(userId) && isValidAnalysis(incoming());
        allow update: if isValidId(userId) && isValidId(analysisId) && isOwner(userId) && isValidAnalysis(incoming());
        allow delete: if isValidId(userId) && isValidId(analysisId) && isOwner(userId);
      }
    }
  }
}
